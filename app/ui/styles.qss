/* ========================================================
   Modern Dark Theme Stylesheet for Voice Engine Studio
   ======================================================== */

QMainWindow, QWidget#CentralWidget {
    background-color: #12131a;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
}

/* Sidebar */
QFrame#Sidebar {
    background-color: #181926;
    border-right: 1px solid #282a36;
}

QPushButton.nav-btn {
    background-color: transparent;
    color: #a6adc8;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.nav-btn:hover {
    background-color: #24273a;
    color: #cad3f5;
}

QPushButton.nav-btn:checked {
    background-color: #363a4f;
    color: #89b4fa;
    font-weight: bold;
}

/* Card / Container panels */
QFrame.card-panel {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 12px;
}

/* Text Editors & Inputs */
QPlainTextEdit, QTextEdit, QLineEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #45475a;
    selection-color: #ffffff;
    font-size: 13px;
}

QPlainTextEdit:focus, QTextEdit:focus, QLineEdit:focus {
    border: 1px solid #89b4fa;
}

/* Combobox */
QComboBox {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 24px;
}

QComboBox:hover {
    border: 1px solid #45475a;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    selection-background-color: #313244;
    selection-color: #89b4fa;
    padding: 4px;
}

/* Buttons */
QPushButton.btn-primary {
    background-color: #89b4fa;
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton.btn-primary:hover {
    background-color: #b4befe;
}

QPushButton.btn-primary:pressed {
    background-color: #74c7ec;
}

QPushButton.btn-primary:disabled {
    background-color: #45475a;
    color: #7f849c;
}

QPushButton.btn-danger {
    background-color: #f38ba8;
    color: #11111b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}

QPushButton.btn-danger:hover {
    background-color: #eba0ac;
}

QPushButton.btn-secondary {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton.btn-secondary:hover {
    background-color: #45475a;
    color: #ffffff;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #313244;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #89b4fa;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #cdd6f4;
    border: 2px solid #89b4fa;
    width: 16px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

/* Progress Bar */
QProgressBar {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    text-align: center;
    color: #cdd6f4;
    font-weight: bold;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 5px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #313244;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #45475a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* Tables */
QTableWidget {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    gridline-color: #24273a;
    color: #cdd6f4;
}

QHeaderView::section {
    background-color: #1e1e2e;
    color: #a6adc8;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #313244;
    font-weight: bold;
}

/* Labels */
QLabel.heading {
    color: #cdd6f4;
    font-size: 16px;
    font-weight: bold;
}

QLabel.subheading {
    color: #a6adc8;
    font-size: 12px;
}

QLabel.badge {
    background-color: #313244;
    color: #89b4fa;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}
